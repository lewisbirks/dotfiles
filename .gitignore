# Ignore everything by default
*

# Track .gitignore, README, and bootstrap script
!.gitignore
!README.md
!_bootstrap.sh

# Window Manager, Shell & Theme Engine
!niri/
!niri/**
niri/noctalia.kdl
!noctalia/
!noctalia/**

# Terminals & CLI Tools
!fastfetch/
!fastfetch/**
!mise/
!mise/**
!superfile/
!superfile/config.toml
!superfile/hotkeys.toml
!zsh/
!zsh/.zshrc
!zsh/.p10k.zsh
!zsh/fzf.zsh
!zsh/aliases.zsh

# GitHub CLI (only config.yml, NEVER hosts.yml which has auth tokens)
!gh/
!gh/config.yml
