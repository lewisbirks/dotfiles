# Ignore everything by default
*

# Track .gitignore and README
!.gitignore
!README.md

# Terminals & CLI Tools
!mise/
!mise/**
!superfile/
!superfile/config.toml
!superfile/hotkeys.toml
!zsh/
!zsh/.zshrc
!zsh/.p10k.zsh
!zsh/fzf.zsh
!zsh/aliases.zsh

# GitHub CLI (only config.yml, NEVER hosts.yml which has auth tokens)
!gh/
!gh/config.yml
