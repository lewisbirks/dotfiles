# Ignore everything by default
*

# Track .gitignore, README, and bootstrap files
!.gitignore
!README.md
!_bootstrap.sh
!Brewfile

# Terminals & CLI Tools
!mise/
!mise/**
!superfile/
!superfile/config.toml
!superfile/hotkeys.toml
!zsh/
!zsh/.zshrc
!zsh/.p10k.zsh
!zsh/fzf.zsh
!zsh/aliases.zsh

# GitHub CLI (only config.yml, NEVER hosts.yml which has auth tokens)
!gh/
!gh/config.yml
