{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Noctalia",
  "author": "Noctalia",
  "themes": [
    {
      "name": "Noctalia Dark",
      "appearance": "dark",
      "style": {
        "background": "{{colors.surface.dark.hex}}",
        "surface.background": "{{colors.surface_container.dark.hex}}",
        "elevated_surface.background": "{{colors.surface_container_high.dark.hex}}",
        "border": "{{colors.outline_variant.dark.hex}}",
        "border.focused": "{{colors.primary.dark.hex}}",
        "text": "{{colors.on_surface.dark.hex}}",
        "text.muted": "{{colors.on_surface_variant.dark.hex}}",
        "text.accent": "{{colors.primary.dark.hex}}",
        "editor.background": "{{colors.surface.dark.hex}}",
        "editor.foreground": "{{colors.on_surface.dark.hex}}",
        "editor.gutter.background": "{{colors.surface.dark.hex}}",
        "editor.active_line.background": "{{colors.surface_container_low.dark.hex}}",
        "editor.line_number": "{{colors.outline.dark.hex}}",
        "editor.active_line_number": "{{colors.primary.dark.hex}}",
        "status_bar.background": "{{colors.surface_container.dark.hex}}",
        "title_bar.background": "{{colors.surface_container.dark.hex}}",
        "tab_bar.background": "{{colors.surface_container_lowest.dark.hex}}",
        "tab.active_background": "{{colors.surface.dark.hex}}",
        "tab.inactive_background": "{{colors.surface_container_lowest.dark.hex}}",
        "panel.background": "{{colors.surface_container_low.dark.hex}}",
        "terminal.background": "{{colors.surface.dark.hex}}",
        "terminal.foreground": "{{colors.on_surface.dark.hex}}",
        "element.hover": "{{colors.surface_container_highest.dark.hex}}",
        "element.selected": "{{colors.secondary_container.dark.hex}}",
        "syntax": {
          "comment": { "color": "{{colors.outline.dark.hex}}", "font_style": "italic" },
          "keyword": { "color": "{{colors.primary.dark.hex}}" },
          "function": { "color": "{{colors.secondary.dark.hex}}" },
          "string": { "color": "{{colors.tertiary.dark.hex}}" },
          "number": { "color": "{{colors.tertiary.dark.hex}}" },
          "type": { "color": "{{colors.primary.dark.hex}}" },
          "variable": { "color": "{{colors.on_surface.dark.hex}}" },
          "property": { "color": "{{colors.on_surface_variant.dark.hex}}" },
          "operator": { "color": "{{colors.secondary.dark.hex}}" }
        }
      }
    },
    {
      "name": "Noctalia Light",
      "appearance": "light",
      "style": {
        "background": "{{colors.surface.light.hex}}",
        "surface.background": "{{colors.surface_container.light.hex}}",
        "elevated_surface.background": "{{colors.surface_container_high.light.hex}}",
        "border": "{{colors.outline_variant.light.hex}}",
        "border.focused": "{{colors.primary.light.hex}}",
        "text": "{{colors.on_surface.light.hex}}",
        "text.muted": "{{colors.on_surface_variant.light.hex}}",
        "text.accent": "{{colors.primary.light.hex}}",
        "editor.background": "{{colors.surface.light.hex}}",
        "editor.foreground": "{{colors.on_surface.light.hex}}",
        "editor.gutter.background": "{{colors.surface.light.hex}}",
        "editor.active_line.background": "{{colors.surface_container_low.light.hex}}",
        "editor.line_number": "{{colors.outline.light.hex}}",
        "editor.active_line_number": "{{colors.primary.light.hex}}",
        "status_bar.background": "{{colors.surface_container.light.hex}}",
        "title_bar.background": "{{colors.surface_container.light.hex}}",
        "tab_bar.background": "{{colors.surface_container_lowest.light.hex}}",
        "tab.active_background": "{{colors.surface.light.hex}}",
        "tab.inactive_background": "{{colors.surface_container_lowest.light.hex}}",
        "panel.background": "{{colors.surface_container_low.light.hex}}",
        "terminal.background": "{{colors.surface.light.hex}}",
        "terminal.foreground": "{{colors.on_surface.light.hex}}",
        "element.hover": "{{colors.surface_container_highest.light.hex}}",
        "element.selected": "{{colors.secondary_container.light.hex}}",
        "syntax": {
          "comment": { "color": "{{colors.outline.light.hex}}", "font_style": "italic" },
          "keyword": { "color": "{{colors.primary.light.hex}}" },
          "function": { "color": "{{colors.secondary.light.hex}}" },
          "string": { "color": "{{colors.tertiary.light.hex}}" },
          "number": { "color": "{{colors.tertiary.light.hex}}" },
          "type": { "color": "{{colors.primary.light.hex}}" },
          "variable": { "color": "{{colors.on_surface.light.hex}}" },
          "property": { "color": "{{colors.on_surface_variant.light.hex}}" },
          "operator": { "color": "{{colors.secondary.light.hex}}" }
        }
      }
    }
  ]
}
